generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CSA
  USER
}

model Distributor {
  id                       String        @id @default(cuid())
  companyName              String
  ownerName                String
  email                    String        @unique
  phone                    String
  city                     String
  gstIn                    String        @unique
  isActive                 Boolean       @default(true)
  totalCompanyDebits        Decimal       @default(0)
  totalAmountRealized       Decimal       @default(0)
  pendingCompanyBalance     Decimal       @default(0)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  adminId                  String?
  admin                    User?         @relation("AdminDistributors", fields: [adminId], references: [id], onDelete: SetNull)
  csaId                    String?
  csa                      User?         @relation("CSADistributors", fields: [csaId], references: [id], onDelete: SetNull)
  users                    User[]
  products                 Product[]
  userStocks               UserStock[]
  parties                  Party[]
  invoices                 Invoice[]
  invoiceItems             InvoiceItem[]
  purchaseLedgers          PurchaseLedger[]
  purchaseItems            PurchaseItem[]
  claims                   Claim[]
  salesReturns             SalesReturn[]
  salesReturnItems         SalesReturnItem[]
  paymentsIn               PaymentIn[]
  purchaseReturns          PurchaseReturn[]
  purchaseReturnItems      PurchaseReturnItem[]
  paymentsOut              PaymentOut[]
  suppliers                Supplier[]
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         Role          @default(USER)
  isActive     Boolean       @default(true)
  logo         String?
  phone        String?
  gstin        String?
  city         String?
  distributorId String?
  distributor  Distributor?  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  adminId      String?
  admin        User?         @relation("AdminCSAs", fields: [adminId], references: [id], onDelete: SetNull)
  managedDistributors Distributor[] @relation("AdminDistributors")
  managedCSAs  User[]        @relation("AdminCSAs")
  managedCsaDistributors Distributor[] @relation("CSADistributors")
  createdInvoices Invoice[] @relation("CreatedInvoices")
  userStocks   UserStock[]
  parties      Party[]
  products     Product[]
  invoices     Invoice[]
  invoiceItems InvoiceItem[]
  receivedInvoices Invoice[] @relation("ReceivedInvoices")
  receivedInvoiceItems InvoiceItem[] @relation("ReceivedInvoiceItems")
  purchaseLedgers PurchaseLedger[] @relation("PurchaseLedgerCsa")
  purchasesReceived PurchaseLedger[] @relation("PurchaseLedgerTargetCsa")
  purchaseItems PurchaseItem[]
  salesReturns SalesReturn[]
  salesReturnItems SalesReturnItem[]
  paymentsIn   PaymentIn[]
  purchaseReturns PurchaseReturn[]
  purchaseReturnItems PurchaseReturnItem[]
  paymentsOut  PaymentOut[]
  claims       Claim[]
  suppliers    Supplier[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Party {
  id          String        @id @default(cuid())
  name        String
  gstin       String?
  address     String?
  creditLimit Decimal?
  phone       String?
  margin      Decimal?
  distributorId String?
  distributor Distributor?  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  csaId       String?
  csa         User?         @relation(fields: [csaId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  invoices    Invoice[]
  salesReturns SalesReturn[]
  paymentsIn  PaymentIn[]
}

model MasterProduct {
  id                  String               @id @default(cuid())
  name                String
  sku                 String               @unique
  hsn                 String?
  batchNo             String?
  expiryDate          DateTime?
  costPrice           Decimal
  baseSellingPrice    Decimal
  gstPercentage       Decimal
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  userStocks          UserStock[]
}

model UserStock {
  id                  String               @id @default(cuid())
  masterProductId     String
  masterProduct       MasterProduct        @relation(fields: [masterProductId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  distributorId       String?
  distributor         Distributor?         @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  currentStock        Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  @@unique([masterProductId, userId])
  @@unique([masterProductId, distributorId])
}

// Keep the old Product model for backward compatibility
model Product {
  id                  String               @id @default(cuid())
  name                String
  sku                 String
  hsn                 String?
  batchNo             String?
  expiryDate          DateTime?
  costPrice           Decimal
  baseSellingPrice    Decimal
  gstPercentage       Decimal
  currentStock        Int                  @default(0)
  distributorId       String?
  distributor         Distributor?         @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  csaId               String?
  csa                 User?                @relation(fields: [csaId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  invoiceItems        InvoiceItem[]
  purchaseItems       PurchaseItem[]
  salesReturnItems    SalesReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNo     String
  partyId       String?
  party         Party?        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  distributorId String?
  distributor   Distributor?  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  csaId         String?
  csa           User?         @relation(fields: [csaId], references: [id], onDelete: Cascade)
  receiverCsaId String?
  receiverCsa   User?         @relation("ReceivedInvoices", fields: [receiverCsaId], references: [id], onDelete: Cascade)
  createdById   String?
  createdBy     User?         @relation("CreatedInvoices", fields: [createdById], references: [id], onDelete: SetNull)
  date          DateTime      @default(now())
  taxableValue  Decimal
  cgst          Decimal       @default(0)
  sgst          Decimal       @default(0)
  igst          Decimal       @default(0)
  grandTotal    Decimal
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  invoiceItems  InvoiceItem[]
}

model InvoiceItem {
  id                  String     @id @default(cuid())
  invoiceId           String
  invoice             Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId           String
  product             Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  distributorId       String?
  distributor         Distributor?  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  csaId               String?
  csa                 User?      @relation(fields: [csaId], references: [id], onDelete: Cascade)
  receiverCsaId       String?
  receiverCsa         User?      @relation("ReceivedInvoiceItems", fields: [receiverCsaId], references: [id], onDelete: Cascade)
  qty                 Int
  costPrice           Decimal?
  rate                Decimal
  gstPercentage       Decimal
  extraMarginPercentage Decimal  @default(0)
  total               Decimal
  createdAt           DateTime   @default(now())
}

model PurchaseLedger {
  id             String         @id @default(cuid())
  supplierName   String
  supplierId     String?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceNo      String
  date           DateTime       @default(now())
  totalAmount    Decimal
  status         String         @default("APPROVED")
  distributorId  String?
  distributor    Distributor?   @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  csaId          String?
  csa            User?          @relation("PurchaseLedgerCsa", fields: [csaId], references: [id], onDelete: Cascade)
  targetCsaId    String?
  targetCsa      User?          @relation("PurchaseLedgerTargetCsa", fields: [targetCsaId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  purchaseItems  PurchaseItem[]
}

model PurchaseItem {
  id           String          @id @default(cuid())
  purchaseId   String
  purchase     PurchaseLedger  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  distributorId String?
  distributor  Distributor?    @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  csaId        String?
  csa          User?           @relation(fields: [csaId], references: [id], onDelete: Cascade)
  qty           Int
  costPrice     Decimal
  mrp           Decimal?
  rate          Decimal?
  discount      Decimal?
  gstPercentage Decimal?
  total         Decimal?
  sortOrder     Int?
  batchNo       String?
  expiryDate    DateTime?
  createdAt     DateTime        @default(now())
}

enum ClaimStatus {
  PENDING
  APPROVED
  PAID
}

model Claim {
  id              String      @id @default(cuid())
  brandName       String
  claimDetails    String
  amount          Decimal
  status          ClaimStatus @default(PENDING)
  distributorId   String
  distributor     Distributor  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  csaId           String?
  csa             User?        @relation(fields: [csaId], references: [id], onDelete: SetNull)
  createdByRole   String      @default("DISTRIBUTOR")
  createdByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model SalesReturn {
  id              String            @id @default(cuid())
  returnNo        String
  partyId         String?
  party           Party?             @relation(fields: [partyId], references: [id], onDelete: Cascade)
  distributorId   String?
  distributor     Distributor?       @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  csaId           String?
  csa             User?              @relation(fields: [csaId], references: [id], onDelete: Cascade)
  date            DateTime          @default(now())
  reason          String?
  taxableValue    Decimal
  cgst            Decimal           @default(0)
  sgst            Decimal           @default(0)
  igst            Decimal           @default(0)
  grandTotal      Decimal
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  salesReturnItems SalesReturnItem[]
}

model SalesReturnItem {
  id               String         @id @default(cuid())
  salesReturnId    String
  salesReturn      SalesReturn    @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  distributorId    String?
  distributor      Distributor?   @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  csaId            String?
  csa              User?          @relation(fields: [csaId], references: [id], onDelete: Cascade)
  qty              Int
  costPrice        Decimal?
  rate             Decimal
  gstPercentage    Decimal
  total            Decimal
  createdAt        DateTime       @default(now())
}

model PaymentIn {
  id             String      @id @default(cuid())
  paymentNo      String
  partyId        String?
  party          Party?       @relation(fields: [partyId], references: [id], onDelete: Cascade)
  distributorId  String?
  distributor    Distributor? @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  csaId          String?
  csa            User?        @relation(fields: [csaId], references: [id], onDelete: Cascade)
  date           DateTime    @default(now())
  amount         Decimal
  paymentMode    String
  referenceNo    String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model PurchaseReturn {
  id                 String                @id @default(cuid())
  returnNo           String
  supplierName       String
  supplierId         String?
  supplier           Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  distributorId      String?
  distributor        Distributor?          @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  csaId              String?
  csa                User?                 @relation(fields: [csaId], references: [id], onDelete: Cascade)
  date               DateTime              @default(now())
  reason             String?
  taxableValue       Decimal
  cgst               Decimal               @default(0)
  sgst               Decimal               @default(0)
  igst               Decimal               @default(0)
  grandTotal         Decimal
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  purchaseReturnItems PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id                 String         @id @default(cuid())
  purchaseReturnId   String
  purchaseReturn     PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  productId          String
  product            Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  distributorId      String?
  distributor        Distributor?   @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  csaId              String?
  csa                User?          @relation(fields: [csaId], references: [id], onDelete: Cascade)
  qty                Int
  costPrice          Decimal
  gstPercentage      Decimal
  total              Decimal
  createdAt          DateTime       @default(now())
}

model Supplier {
  id             String        @id @default(cuid())
  name           String
  phone          String?
  email          String?
  gstin          String?
  address        String?
  distributorId  String?
  distributor    Distributor?  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  csaId          String?
  csa            User?         @relation(fields: [csaId], references: [id], onDelete: Cascade)
  isForAllCSAs   Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  purchaseLedgers PurchaseLedger[]
  purchaseReturns PurchaseReturn[]
  paymentsOut   PaymentOut[]
}

model PaymentOut {
  id             String        @id @default(cuid())
  paymentNo      String
  supplierName   String
  supplierId     String?
  supplier       Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  distributorId  String?
  distributor    Distributor?  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  csaId          String?
  csa            User?         @relation(fields: [csaId], references: [id], onDelete: Cascade)
  date           DateTime      @default(now())
  amount         Decimal
  paymentMode    String
  referenceNo    String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
